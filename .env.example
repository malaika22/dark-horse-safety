# Environment template — copy secrets into apps/api/.env (never commit real keys)

# --- API (apps/api/.env) ---

# Server
PORT=3002
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Database (Postgres)
DATABASE_URL="postgresql://darkhorse:darkhorse@localhost:5433/dark_horse_safety?schema=public"

# JWT
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN="7d"

# Email — Resend (production) + optional SMTP fallback (dev)
# https://resend.com
RESEND_API_KEY=re_xxxxxxxxx
# Dev/test sender (only delivers to your Resend signup email):
MAIL_FROM="Dark Horse Safety <onboarding@resend.dev>"
# Production sender after verifying darkhorseops.com at resend.com/domains:
# MAIL_FROM="Dark Horse Safety <noreply@darkhorseops.com>"
ADMIN_EMAIL="laiba2618@gmail.com"

# SMTP fallback — delivers to ANY email until Resend domain is verified.
# Gmail: https://myaccount.google.com/apppasswords (enable 2FA first)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=laiba2618@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="Dark Horse Safety <laiba2618@gmail.com>"

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx
GOOGLE_CALLBACK_URL="http://localhost:3002/auth/google/callback"

# Auth lockout
# Auth lockout — configurable
# Wrong passwords before lock: MAX_LOGIN_ATTEMPTS (default 5)
# Lock duration in minutes: LOCK_DURATION_MINUTES (default 15)
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15

# Token TTLs
PASSWORD_RESET_EXPIRES_MINUTES=60
INVITE_EXPIRES_DAYS=7

# --- Dashboard (apps/dashboard/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:3002
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_NETSUITE_CUSTOMER_URL=
#
# Google Cloud Console → OAuth Web client → Authorized JavaScript origins:
#   http://localhost:3000
# (Login button uses GIS popup; redirect URI not required for that flow)
# Optional redirect flow URI (API):
#   http://localhost:3002/auth/google/callback
